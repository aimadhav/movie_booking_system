{
  "name": "movie-booking-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:web": "npm --prefix web run dev",
    "dev:all": "concurrently --kill-others --names api,worker,web --prefix-colors cyan,magenta,yellow \"npm:dev\" \"npm:dev:worker\" \"npm:dev:web\"",
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:web": "npm --prefix web test",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:concurrency": "vitest run --config vitest.integration.config.ts tests/integration/booking-concurrency.test.ts",
    "test:payments": "vitest run --config vitest.integration.config.ts tests/integration/payment-inbox.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.0",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "9.2.1",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
